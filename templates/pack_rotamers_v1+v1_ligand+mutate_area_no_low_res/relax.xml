<ROSETTASCRIPTS>
  <SCOREFXNS>
          <ScoreFunction name="hard_rep" weights="ligand" />
  </SCOREFXNS>

  <RESIDUE_SELECTORS>

    <Neighborhood name="surrounding_repack" resnums="{resnums_str_placeholder}" distance="100000"/>
    <Not name="rest_repack" selector="surrounding_repack"/>

  </RESIDUE_SELECTORS>


  <TASKOPERATIONS>
    <InitializeFromCommandline name="init"/>
    <OperateOnResidueSubset name="repack_res" selector="surrounding_repack">
      <RestrictToRepackingRLT/>
    </OperateOnResidueSubset>
    <OperateOnResidueSubset name="no_repack" selector="rest_repack">
      <PreventRepackingRLT/>
    </OperateOnResidueSubset>

  </TASKOPERATIONS>


  <MOVERS>
    <!-- take residue 55 in chain A and mutate it to an Alanine (A)-->
    {mutate_residue_placeholders}
    <PackRotamersMover name="pack_rotamers"
               scorefxn="hard_rep"
               task_operations="init,repack_res,no_repack"
               />
  </MOVERS>
  <PROTOCOLS>
    <!-- make sure to add a new mover for each new mutant-->
    {protocols_placeholders}
    <Add mover_name="pack_rotamers"/>
  </PROTOCOLS>
  <OUTPUT scorefxn="hard_rep"/>
</ROSETTASCRIPTS>